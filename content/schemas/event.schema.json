{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magnate.game/schemas/event.schema.json",
  "title": "EventDefinition",
  "description": "A random or conditional world event. Phase 3.65 ships with random triggers and three effect types (price multiplier, brand shift, headline-only).",
  "type": "object",
  "required": ["id", "name", "trigger", "effects", "weight", "severity"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable machine id. Lowercase snake_case."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Headline text — also the default news-log headline."
    },
    "description": {
      "type": "string",
      "description": "Long-form flavor text shown in the ticker / feed expand panel."
    },
    "weight": {
      "type": "integer",
      "minimum": 1,
      "description": "Relative likelihood among eligible events. Higher = more likely."
    },
    "severity": {
      "enum": ["Info", "Notable", "Major"]
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["random"],
          "description": "Phase 3.65 ships with 'random' only; later phases will add conditional triggers."
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["world_market_price_multiplier", "price_multiplier", "brand_shift", "headline"]
          },
          "productId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "multiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "durationMonths": {
            "type": "integer",
            "minimum": 1
          },
          "delta": {
            "type": "integer"
          }
        }
      }
    }
  }
}
