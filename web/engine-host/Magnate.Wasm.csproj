<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    Browser host for the Magnate engine. Compiles Magnate.Engine + Magnate.Bridge
    to WebAssembly and exposes the bridge via [JSExport]. Built and copied into
    web/public/_framework by `npm run build:engine` (web/scripts/build-engine.mjs).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Magnate.Wasm</RootNamespace>
    <AssemblyName>Magnate.Wasm</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- JSExport is browser-only by definition; the platform analyzer can't see that. -->
    <NoWarn>$(NoWarn);CA1416;IL2026;IL2104;IL3050;IL3053</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Engine + bridge are rooted below and use reflection-based System.Text.Json by design,
         so the trimmer's reflection warnings are expected; the smoke test proves the published build. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Magnate.Bridge\Magnate.Bridge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reflection-heavy assemblies (JSON DTOs, bridge handler discovery) must survive trimming. -->
    <TrimmerRootAssembly Include="Magnate.Engine" />
    <TrimmerRootAssembly Include="Magnate.Bridge" />
  </ItemGroup>
  <ItemGroup>
    <!-- Game content ships inside the assembly and is extracted to the in-memory FS at boot. -->
    <EmbeddedResource Include="..\..\content\data\**\*.json" LogicalName="content/data/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\content\scenarios\*.json" LogicalName="content/scenarios/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
