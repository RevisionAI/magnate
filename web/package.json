{
  "name": "magnate-web",
  "private": true,
  "version": "0.1.0",
  "description": "Magnate — browser client (Three.js city + React UI) running the C# engine via WebAssembly",
  "type": "module",
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:all": "npm run build:engine && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "camera-controls": "3.1.2",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.49.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "lil-gui": "^0.21.0",
    "puppeteer-core": "^23.11.1",
    "stats-gl": "^4.2.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
