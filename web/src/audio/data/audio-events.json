    ],
    "taxPaid": [{ "doc": "proposed", "sfx": "tax_paid", "vo": { "line": "adv.tax.paid", "rank": 3 } }],
    "dividendPaid": [{ "sfx": "coins_small", "vo": { "line": "adv.dividend.declared", "rank": 3 } }],
    "dividendDeclared": [{ "doc": "proposed alias of dividendPaid", "sfx": "coins_small", "vo": { "line": "adv.dividend.declared", "rank": 3 } }],
    "ipoEligible": [{ "doc": "proposed", "sfx": "notify_opportunity", "vo": { "line": "adv.ipo.eligible", "rank": 2 } }],
    "ipoCompleted": [
      { "if": { "isPlayer": true }, "sfx": ["ipo_bell", { "id": "coins_large", "delay": 1.0 }], "music": { "stinger": "stinger.ipo" }, "vo": { "line": "adv.ipo.complete", "chain": ["news.ipo_debut", "adv.ipo.complete"], "rank": 2, "newsSting": true } },
      { "sfx": "news_sting", "vo": { "line": "news.ipo_debut", "rank": 3 } }
    ],
    "sharePriceMove": [
      { "doc": "proposed", "if": { "dir": "up" }, "sfx": "ticker_up", "vo": { "line": "adv.stock.surge", "rank": 3 } },
      { "if": { "dir": "down" }, "sfx": "ticker_down", "vo": { "line": "adv.stock.crash", "rank": 3 }, "music": { "drawdown": true } }
    ],
    "indexMove": [
      { "doc": "proposed", "if": { "dir": "down" }, "sfx": "news_sting", "vo": { "line": "news.market_crash", "rank": 3 }, "music": { "stinger": "stinger.crash" } },
      { "if": { "dir": "up" }, "sfx": "news_sting", "vo": { "line": "news.market_rally", "rank": 3 } }
    ],
    "takeoverBid": [
      { "sfx": "rival_alert", "vo": { "line": "adv.stock.takeover_threat", "rank": 1 }, "music": { "warning": true } }
    ],
    "stakeAlert": [
      { "doc": "proposed", "sfx": "rival_alert", "vo": { "line": "adv.stock.takeover_threat", "rank": 1 }, "music": { "warning": true } }
    ],
    "macroShift": [
      { "doc": "reason = macro phase (bridge-spec 8.6)", "if": { "reason": "recession" }, "sfx": "newspaper", "music": { "climate": "recession" }, "vo": { "line": "adv.macro.recession", "chain": ["news.recession", "adv.macro.recession"], "rank": 1, "newsSting": true } },
      { "if": { "reason": "panic" }, "sfx": "newspaper", "music": { "climate": "panic" }, "vo": { "line": "adv.macro.recession", "chain": ["news.recession", "adv.macro.recession"], "rank": 1, "newsSting": true } },
      { "if": { "reason": "recovery" }, "sfx": "newspaper", "music": { "climate": "normal" }, "vo": { "line": "adv.macro.recovery", "chain": ["news.recovery", "adv.macro.recovery"], "rank": 2, "newsSting": true } },
      { "if": { "reason": "expansion" }, "music": { "climate": "prosperous" } },
      { "if": { "reason": "peak" }, "sfx": "newspaper", "music": { "climate": "boom", "stinger": "stinger.boom" }, "vo": { "line": "adv.macro.boom", "chain": ["news.boom", "adv.macro.boom"], "rank": 2, "newsSting": true } },
      { "if": { "reason": "boom" }, "sfx": "newspaper", "music": { "climate": "boom", "stinger": "stinger.boom" }, "vo": { "line": "adv.macro.boom", "chain": ["news.boom", "adv.macro.boom"], "rank": 2, "newsSting": true } }
    ],
    "climateChanged": [
      { "doc": "proposed alias of macroShift (reason = climate)", "alias": "macroShift" }
